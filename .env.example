# Copy to .env and fill locally; never commit credentials.
LLM_MODEL=glm-4.7
LLM_API_KEY=
# Omit this variable for the provider default; do not set an empty URL.
# LLM_BASE_URL=https://your-endpoint.example/v1
LLM_STRUCTURED_METHOD=function_calling
LLM_MAX_RETRIES=0
LOG_LEVEL=INFO
MAX_JOBS=20
MAX_REPAIR_ATTEMPTS=2
REQUEST_TIMEOUT_SECONDS=60
# Optional local path overrides:
# KNOWLEDGE_DIR=data/knowledge
# VECTOR_INDEX_DIR=data/vector_index

EMBEDDING_MODEL_PATH=E:/00project/02agent/models/bge-large-zh-v1.5
EMBEDDING_DEVICE=cpu
RERANKER_MODEL_PATH=E:/00project/02agent/models/bge-reranker-v2-m3
